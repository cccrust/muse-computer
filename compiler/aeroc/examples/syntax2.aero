// 新語法：if / else if / else、&&、一元 - 與 !、索引 a[i]、字典索引
struct Box { mut items: Array[Int] } end
gc struct Bag { mut nums: Array[Int] } end

fn classify(n: Int) -> String
  if n < 0
    return "negative";
  else if n == 0
    return "zero";
  else
    return "positive";
  end
end

fn main() -> Unit
  println(classify(-5));
  println(classify(0));
  println(classify(7));

  let xs = [10, 20, 30];
  println(xs[1] + xs[2]);

  let mut ys = [1, 2, 3];
  ys[0] = 99;
  ys[1] = ys[1] * 5;
  println(ys[0] + ys[1]);

  let ok = !(xs[0] > 100) && xs[2] == 30;
  if ok
    println("and-ok");
  end
  if false || (1 > 2)
    println("never");
  else
    println("or-else");
  end

  let d = { "a": 1, "b": 2 };
  println(d["b"] - -3);

  let b = Box { items: [5, 6, 7] };
  println(b.items[2]);

  managed {
    let bag = gc Bag { nums: [1, 2, 3] };
    bag.nums[1] = bag.nums[1] + bag.nums[2];
    println(bag.nums[1]);
    let mut i = 0;
    while i < 3
      bag.nums[i] = bag.nums[i] * 2;
      i = i + 1;
    end
    println(bag.nums[0] + bag.nums[1] + bag.nums[2]);
  }
end
