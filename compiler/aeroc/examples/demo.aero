// Aero demo：Zero-GC、管線、lambda、managed/gc 循環引用、FFI、unsafe
extern "C" { fn labs(x: Int) -> Int; } end

struct Point { x: Int, y: Int } end

gc struct Node { mut value: Int, mut links: Array[gc Node] } end

fn make_point(x: Int, y: Int) -> Point
  return Point { x: x, y: y };
end

fn add(a: Int, b: Int) -> Int
  return a + b;
end

fn double(n: Int) -> Int
  return n * 2;
end

fn sum(items: &Array[Int]) -> Int
  let mut total = 0;
  for i in items
    total = total + i;
  end
  return total;
end

fn bump(n: &mut Node) -> Unit
  n.value = n.value + 1;
end

fn show(n: &Node) -> Unit
  println(n.value);
end

fn main() -> Unit
  // --- Zero-GC ---
  let p = make_point(3, 4);
  println(p.x + p.y);
  let xs = [1, 2, 3, 4];
  println(sum(&xs));
  let r: Int = 3 |> add(4);
  println(r);
  println(5 |> double |> double);
  let inc = |x: Int| -> Int x + 1 end;
  println(inc(41));
  let greeting = "hello" + ", " + "aero";
  println(greeting);
  let mut i = 0;
  while i < 3
    i = i + 1;
  end
  println(i);

  // --- Managed-GC：雙向循環引用 + 多重可變共享 ---
  managed {
    let a = gc Node { value: 1, links: [] };
    let b = gc Node { value: 2, links: [] };
    a.links.push(b);
    b.links.push(a);
    a.value = a.value + 10;
    let alias = a;
    alias.value = alias.value + 100;
    println(a.value);
    bump(&mut a);
    show(&a);
    println(a.links.len());
    let copy: Node = a.clone_to_owned();
    println(copy.value);
  }
  std::gc::collect();

  // --- FFI + unsafe ---
  unsafe {
    let v = labs(0 - 5);
    println(v);
  } end
end
